env: local
rest:
  host: 127.0.0.1
  port: 3333
  timeout:
    read: 15s
    write: 10s
    idle: 5s
grpc:
  port: 44044
  timeout: 5s
photo-storage: local
auth:
  jwt:
    access:
      key: CHANGE_ME_dev_only_access_key_000000
      expired_in: 12h
    refresh:
      key: CHANGE_ME_dev_only_refresh_key_00000
      expired_in: 24h
db:
  host: 127.0.0.1
  port: 5432
  username: postgres
  password: postgres
  name: problem_map
  sslmode: disable
  pool:
    max_open_conns: 25
    max_idle_conns: 5
    conn_max_lifetime: 5m
redis:
  host: 127.0.0.1
  port: 6379
  password:
aws:
  key:
  secret_key:
  endpoint: