env: local
rest:
  host: 127.0.0.1
  port: 3333
  timeout:
    read: 15s
    write: 10s
    idle: 5s
grpc:
  port: 44044
  timeout: 5s
  connection-timeout: 120s
  metrics-port: 9091
health:
  timeout: 3s
  cache-ttl: 2s
shutdown-timeout: 10s
photo-storage: local
auth:
  jwt:
    access:
      key: CHANGE_ME_dev_only_access_key_000000
      expired_in: 12h
    refresh:
      key: CHANGE_ME_dev_only_refresh_key_00000
      expired_in: 24h
db:
  host: 127.0.0.1
  port: 5432
  username: postgres
  password: postgres
  name: problem_map
  sslmode: disable
  pool:
    max_open_conns: 25
    max_idle_conns: 5
    conn_max_lifetime: 5m
redis:
  host: 127.0.0.1
  port: 6379
  password:
aws:
  key:
  secret_key:
  endpoint:
tasker:
  interval: 15m
  task-ttl: 72h
  max-tasks-per-user: 3
  required-checks: 2
  target-probability: 0.8
  max-radius-meters: 5000
  distance-lambda: 0.05
  load-delta: 0.3
  fatigue-beta: 0.2
