env: local
rest:
  host: 127.0.0.1
  port: 3333
  timeout:
    read: 15s
    write: 10s
    idle: 5s
grpc:
  port: 44044
  timeout: 5s
  connection-timeout: 120s
  metrics-port: 9091
health:
  timeout: 3s
  cache-ttl: 2s
shutdown-timeout: 10s
photo-storage: local
auth:
  jwt:
    access:
      key: qwer
      expired_in: 12h
    refresh:
      key: 1234
      expired_in: 24h
db:
  host: 127.0.0.1
  port: 5432
  username: postgres
  password: postgres
  name: problem_map
redis:
  host: 127.0.0.1
  port: 6379
  password:
aws:
  key:
  secret_key:
  endpoint: