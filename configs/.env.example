ENV=local

REST_HOST=localhost
REST_PORT=3334
REST_TIMEOUT_READ=15s
REST_TIMEOUT_WRITE=10s
REST_TIMEOUT_IDLE=5s

GRPC_PORT=44044
GRPC_TIMEOUT=5s
GRPC_CONNECTION_TIMEOUT=120s
GRPC_METRICS_PORT=9091

PHOTO_STORAGE=local

JWT_ACCESS_TOKEN_KEY=CHANGE_ME_dev_only_access_key_000000
JWT_ACCESS_TOKEN_EXPIRED_IN=5m
JWT_REFRESH_TOKEN_KEY=CHANGE_ME_dev_only_refresh_key_00000
JWT_REFRESH_TOKEN_EXPIRED_IN=24h

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=problem_map
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AWS_KEY=
AWS_SECRET_KEY=
AWS_ENDPOINT=

# Domain-event broker (empty = events not published; required by notifier)
NATS_URL=
NATS_NAME=problem-map

# Push delivery in cmd/notifier (see README, "Push-уведомления"). Without FCM
# credentials pushes are only logged.
PUSH_SEND_TIMEOUT=15s
# FCM (HTTP v1): set exactly one of FCM_CREDENTIALS_FILE / FCM_CREDENTIALS_JSON
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
FCM_TIMEOUT=5s
FCM_MAX_RETRIES=3
FCM_CONCURRENCY=8
# APNs (reserved, sender not implemented yet)
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_SANDBOX=false
# Prometheus /metrics port of cmd/notifier (0 = disabled)
# jetstream (default, at-least-once) | core (at-most-once)
NATS_DELIVERY=jetstream
# Prometheus port of cmd/notifier; 0 disables
NOTIFIER_METRICS_PORT=0
