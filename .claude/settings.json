{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-post-edit.sh", "timeout": 60 }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go test:*)", "Bash(go vet:*)", "Bash(go build:*)", "Bash(gofmt:*)",
      "Bash(golangci-lint:*)", "Bash(make test:*)", "Bash(make swag:*)", "Bash(mockery:*)",
      "Bash(migrate create:*)"
    ]
  }
}
